# Build context: thư mục gốc repo
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

# Chép package.json của mọi workspace để npm ci khớp lockfile, nhưng chỉ cài phần của API + shared
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/mobile/package.json apps/mobile/
RUN npm ci --include=dev -w @f2m/api -w @f2m/shared --no-audit --no-fund

COPY packages/shared packages/shared
COPY apps/api apps/api
COPY db db

WORKDIR /app/apps/api
EXPOSE 8140
# Chạy migration rồi khởi động API (tsx chạy thẳng TypeScript)
CMD ["sh", "-c", "npx tsx src/migrate.ts && exec npx tsx src/index.ts"]
