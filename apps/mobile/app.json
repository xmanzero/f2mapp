{
  "expo": {
    "name": "pcdex",
    "slug": "f2m",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "f2m",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080F24",
    "ios": {
      "bundleIdentifier": "app.pcdex",
      "supportsTablet": true
    },
    "android": {
      "package": "app.pcdex",
      "adaptiveIcon": {
        "backgroundColor": "#080F24",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080F24",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "pcdex dùng camera để quét mã QR của phần mềm pcdex-scan và gắn máy vào tài khoản.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "pcdex cần quyền thư viện ảnh để bạn gửi ảnh trong tin nhắn.",
          "cameraPermission": "pcdex dùng camera để chụp ảnh gửi trong tin nhắn."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
